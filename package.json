{
  "name": "project-generator-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/desktop"
  ],
  "scripts": {
    "build:supervisor": "node scripts/build-windows-supervisor.mjs",
    "build:supervisor:test": "node scripts/build-windows-supervisor.mjs --debug-only",
    "build:release": "npm run build:supervisor && npm run build --workspace @project-generator/core && node scripts/set-core-build-profile.mjs release && npm run build --workspace @project-generator/cli",
    "build:development": "npm run build:supervisor && npm run build --workspace @project-generator/core && node scripts/set-core-build-profile.mjs development && npm run build --workspace @project-generator/cli",
    "build": "npm run build:release",
    "typecheck": "npm run typecheck --workspace @project-generator/core && npm run typecheck --workspace @project-generator/cli && npm run typecheck --workspace @project-generator/desktop",
    "test": "npm run build:development && npm run build:supervisor:test && npm run test --workspace @project-generator/core && npm run test --workspace @project-generator/cli && npm run test --workspace @project-generator/desktop",
    "test:e2e:phase-04b3:cli": "npm run build:development && node scripts/phase-04b3-cli-e2e.mjs",
    "test:e2e:phase-04b3:native": "node scripts/phase-04b3-native-e2e.mjs",
    "test:e2e:phase-05a:cli": "npm run build:development && node scripts/phase-05a-cli-e2e.mjs",
    "test:e2e:phase-05a:native": "node scripts/phase-05a-native-e2e.mjs",
    "test:e2e:phase-05b:cli": "npm run build:development && node scripts/phase-05b-cli-e2e.mjs",
    "test:e2e:phase-05b:native": "node scripts/phase-05b-native-e2e.mjs",
    "test:e2e:phase-05c3:cli": "npm run build:development && node scripts/phase-05c3-cli-e2e.mjs",
    "test:e2e:phase-05c3:native": "node scripts/phase-05c3-native-e2e.mjs",
    "test:e2e:phase-05d1:cli": "npm run build:development && node scripts/phase-05d1-nest-cli-e2e.mjs",
    "test:e2e:phase-05d1:native": "node scripts/phase-05d1-nest-native-e2e.mjs",
    "test:e2e:phase-05d2:cli": "npm run build:development && node scripts/phase-05d2-gin-cli-e2e.mjs",
    "test:e2e:phase-05d2:native": "node scripts/phase-05d2-gin-native-e2e.mjs",
    "test:policy:phase-05d2": "npm run build:release && node scripts/phase-05d2-gin-release-policy.mjs",
    "test:policy:phase-05b": "npm run build:release && node scripts/phase-05b-release-policy.mjs",
    "test:policy:phase-05c1": "npm run build:release && node scripts/phase-05c1-release-policy.mjs",
    "test:policy:phase-05c3": "npm run build:release && node scripts/phase-05c1-release-policy.mjs",
    "test:policy:phase-05d1": "npm run build:release && node scripts/phase-05c1-release-policy.mjs",
    "desktop:dev": "node scripts/desktop.mjs dev system",
    "desktop:build:system": "node scripts/desktop.mjs build system",
    "desktop:build:bundled": "node scripts/desktop.mjs build bundled",
    "lint": "eslint packages/*/src/**/*.{ts,tsx} packages/*/test/**/*.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
