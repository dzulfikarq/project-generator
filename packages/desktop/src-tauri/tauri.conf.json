{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Generator",
  "version": "0.1.0",
  "identifier": "com.dzulfikarq.project-generator",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev --workspace @project-generator/desktop",
    "beforeBuildCommand": "npm --prefix ../.. run build --workspace @project-generator/desktop",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Project Generator — Internal PoC",
        "width": 1040,
        "height": 820,
        "minWidth": 760,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "resources": ["resources/pg-runtime/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
